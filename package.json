{
  "name": "sejours-sportifs",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @sejours/api",
    "dev:web": "npm run dev --workspace @sejours/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @sejours/api",
    "admin:create": "npm run admin:create --workspace @sejours/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
